# ---------------------------------------------------------------------------
# Backblaze  (required, already working)
# ---------------------------------------------------------------------------
BACKBLAZE_APPLICATION_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_MEDIA_BUCKET=
BACKBLAZE_COMPLIANCE_BUCKET=
# S3 endpoint host only, no bucket path. e.g. https://s3.us-west-002.backblazeb2.com
BACKBLAZE_ENDPOINT_URL=
# must match the region in the endpoint host. e.g. us-west-002
BACKBLAZE_REGION=

# port the API listens on. must match BUN_PUBLIC_API_URL in frontend/.env
API_PORT=3001

# frontend origins allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:3000


# ---------------------------------------------------------------------------
# Genblaze  (leave these blank)
#
# Genblaze reads its own variable names for the same credentials. storage.py
# copies the BACKBLAZE_ values above into these at startup, so there is one
# place to change a key rather than two that drift apart.
#
# Only fill these in if Genblaze should use a DIFFERENT key or bucket from the
# rest of the app. Anything set here wins over the automatic copy.
# ---------------------------------------------------------------------------
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=


# ---------------------------------------------------------------------------
# Google Gemini  (REQUIRED NEXT — unlocks analyse, filter and write)
#
# Free tier, no card needed. Get it at https://aistudio.google.com/apikey
# This is the one that unblocks three pipeline stages at once.
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=


# ---------------------------------------------------------------------------
# Groq  (needed for the coverage check, Loop 2)
#
# Free tier. https://console.groq.com/keys
# Deliberately a different provider from the writer above. Grading your own
# output with the model that produced it is worthless.
# Skip this if you cut Loop 2 for time.
# ---------------------------------------------------------------------------
GROQ_API_KEY=


# ---------------------------------------------------------------------------
# ElevenLabs  (text to speech)
#
# Free tier at https://elevenlabs.io — check the current character allowance.
# Demo scale is small: a 90s clip needs a few hundred characters, a few
# thousand once the fit loop retries.
#
# Leave blank to use local Piper instead. No key, no limit, lower quality.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=


# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# whisper model size: tiny, base, small, medium, large-v3
# bigger is more accurate and slower. base is the default and fine for clips.
WHISPER_MODEL=base
