# backblaze
BACKBLAZE_APPLICATION_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_MEDIA_BUCKET=
BACKBLAZE_COMPLIANCE_BUCKET=
# S3 endpoint host only, no bucket path. e.g. https://s3.us-west-002.backblazeb2.com
BACKBLAZE_ENDPOINT_URL=
# must match the region in the endpoint host. e.g. us-west-002
BACKBLAZE_REGION=

# frontend origins allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:3000
